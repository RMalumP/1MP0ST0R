{
  "rules": {
    ".read": false,
    ".write": false,
    "probe": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() === now"
      }
    },
    "rooms": {
      ".read": false,
      "$roomId": {
        ".validate": "$roomId.matches(/^[0-9a-f]{64}$/)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid) || (data.exists() && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && root.child('rooms').child($roomId).child('players').child(data.child('host').val()).child('online').val() === false && newData.child('host').val() === auth.uid) || (data.exists() && ((root.child('rooms').child($roomId).child('beat').isNumber() && root.child('rooms').child($roomId).child('beat').val() < now - 600000) || (!root.child('rooms').child($roomId).child('beat').isNumber() && data.child('lastActive').isNumber() && data.child('lastActive').val() < now - 600000)) && newData.child('host').val() === auth.uid))",
          ".validate": "newData.hasChildren(['host','session','createdAt','lastActive','phase','schema'])",
          "host": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "session": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "lastActive": {
            ".validate": "newData.isNumber()"
          },
          "phase": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'alcalde' || newData.val() === 'playing' || newData.val() === 'ended')"
          },
          "schema": {
            ".validate": "newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        },
        "beat": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('rooms').child($roomId).child('meta').child('host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name','joinedAt','session','online']) && newData.child('session').val() === root.child('rooms').child($roomId).child('meta').child('session').val() && ((data.exists() && data.child('session').val() === root.child('rooms').child($roomId).child('meta').child('session').val()) ? newData.child('joinedAt').val() === data.child('joinedAt').val() : (newData.child('joinedAt').val() === now && root.child('rooms').child($roomId).child('meta').child('phase').val() === 'lobby'))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "session": {
              ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('meta').child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['phase','round'])",
          "phase": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'alcalde' || newData.val() === 'playing' || newData.val() === 'ended')"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "settings": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 600"
          },
          "alcalde": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "alcaldeName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "alcaldeWords": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
          },
          "starting": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "timer": {
            ".validate": "newData.hasChildren(['running','remaining','at'])",
            "running": {
              ".validate": "newData.isBoolean()"
            },
            "remaining": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "extra": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 3000"
          },
          "history": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2500"
          },
          "vote": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2500"
          },
          "summary": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 3500"
          },
          "waiting": {
            ".validate": "newData.isBoolean()"
          },
          "ready": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000"
          },
          "eliminated": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000"
          },
          "popup": {
            ".validate": "newData.hasChildren(['id','name','role'])",
            "id": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "role": {
              ".validate": "newData.isString() && (newData.val() === 'impostor' || newData.val() === 'civil' || newData.val() === 'traidor')"
            },
            "$other": {
              ".validate": false
            }
          },
          "result": {
            ".validate": "newData.isString() && (newData.val() === 'civiles' || newData.val() === 'impostores')"
          },
          "$other": {
            ".validate": false
          }
        },
        "roles": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('meta').child('host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($roomId).child('meta').child('host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['round','role','card','res','session']) && newData.child('session').val() === root.child('rooms').child($roomId).child('meta').child('session').val()",
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "role": {
              ".validate": "newData.isString() && (newData.val() === 'impostor' || newData.val() === 'civil')"
            },
            "card": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2500"
            },
            "res": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
            },
            "session": {
              ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40"
            },
            "g": {
              ".validate": "newData.isString() && newData.val().length <= 8000"
            },
            "tr": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "inbox": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('meta').child('host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($roomId).child('meta').child('host').val() === auth.uid",
          "$msgId": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('meta').child('host').val() === auth.uid || (!data.exists() && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && newData.child('from').val() === auth.uid))",
            ".validate": "newData.hasChildren(['from','tipo','ts']) && newData.child('from').val() === auth.uid",
            "from": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },
            "tipo": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "datos": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1500"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}